// Sentinel — Prisma schema (Phase 2: graph model)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum NodeType {
  USE_CASE
  ASSET
  VENDOR
  DATA_ASSET
  JURISDICTION
}

enum EdgeType {
  USES_ASSET        // UseCase -> Asset
  USES_MODEL        // UseCase -> Asset (model deployment)
  OWNED_BY_VENDOR   // Asset  -> Vendor
  STORES_DATA       // Asset  -> DataAsset
  SUBJECT_TO        // UseCase | Asset -> Jurisdiction
  HAS_GRANT         // Asset  -> IdentityGrant (stored as DataAsset node)
  EGRESSES_TO       // Asset  -> Jurisdiction | Asset
}

enum EventType {
  NODE_CREATED
  NODE_UPDATED
  NODE_FLAGGED_LOW_CONFIDENCE
  NODE_CONFIRMED
  EDGE_CREATED
  EDGE_REMOVED
  SYNC_COMPLETED
  RECTIFICATION_OPENED
  RECTIFICATION_UPDATED
  RECTIFICATION_RESOLVED
  EVIDENCE_FILED
}

enum Role {
  ADMIN    // full access
  ANALYST  // read + rectify + confirm nodes + trigger sync
  VIEWER   // read-only
}

enum RectificationStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  WONT_FIX
}

enum RectificationPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ConfidenceLevel {
  HIGH    // observed via live telemetry, unambiguous correlation
  MEDIUM  // telemetry observed but correlation is inferred
  LOW     // manually entered OR correlation is ambiguous — requires confirmation
}

enum DataSource {
  TELEMETRY
  MANUAL
}

// ---------------------------------------------------------------------------
// GraphNode
// ---------------------------------------------------------------------------

model GraphNode {
  id         String          @id               // deterministic, content-addressed
  type       NodeType
  label      String                            // human-readable name
  attributes Json            @default("{}")    // type-specific fields
  confidence ConfidenceLevel @default(HIGH)
  source     DataSource      @default(TELEMETRY)
  confirmed  Boolean         @default(false)   // manual confirmation for LOW confidence nodes
  connectorId String?                          // which connector last observed this
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  edgesFrom  GraphEdge[]     @relation("EdgeFrom")
  edgesTo    GraphEdge[]     @relation("EdgeTo")
  events     Event[]

  @@index([type])
  @@index([connectorId])
}

// ---------------------------------------------------------------------------
// GraphEdge
// ---------------------------------------------------------------------------

model GraphEdge {
  id         String    @id @default(cuid())
  type       EdgeType
  fromId     String
  toId       String
  attributes Json      @default("{}")
  createdAt  DateTime  @default(now())

  from       GraphNode @relation("EdgeFrom", fields: [fromId], references: [id])
  to         GraphNode @relation("EdgeTo",   fields: [toId],   references: [id])

  @@unique([fromId, toId, type])   // prevent duplicate edges of the same type
  @@index([fromId])
  @@index([toId])
}

// ---------------------------------------------------------------------------
// Event  — append-only evidence trail (no updates, no deletes)
// ---------------------------------------------------------------------------

model Event {
  id          String    @id @default(cuid())
  type        EventType
  nodeId      String?
  payload     Json      @default("{}")   // before/after snapshot or signal data
  actor       String    @default("system") // "system", connector id, or user id
  connectorId String?
  createdAt   DateTime  @default(now())

  node        GraphNode? @relation(fields: [nodeId], references: [id])

  @@index([nodeId])
  @@index([createdAt])
  @@index([connectorId])
}

// ---------------------------------------------------------------------------
// User  — local accounts for the prototype (Phase 8)
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  role         Role     @default(VIEWER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
}

// ---------------------------------------------------------------------------
// Rectification  — remediation actions against risk signals / compliance gaps
// Principle 1: "rectify, not transfer" — no insurance or risk-transfer fields.
// ---------------------------------------------------------------------------

model Rectification {
  id           String                @id @default(cuid())
  title        String
  description  String                @default("")
  // Optional link to a GraphNode (use-case, asset, etc.)
  nodeId       String?
  // Optional reference to a compliance obligation id e.g. "gdpr-art35"
  obligationId String?
  // Optional reference to a risk dimension e.g. "modelBehaviour"
  dimensionId  String?
  status       RectificationStatus   @default(OPEN)
  priority     RectificationPriority @default(MEDIUM)
  actor        String                @default("user")
  dueDate      DateTime?
  resolvedAt   DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  evidence     RectificationEvidence[]

  @@index([nodeId])
  @@index([status])
  @@index([obligationId])
}

// ---------------------------------------------------------------------------
// RectificationEvidence  — append-only evidence trail per rectification
// ---------------------------------------------------------------------------

model RectificationEvidence {
  id              String        @id @default(cuid())
  rectificationId String
  content         String        // free-text evidence description
  actor           String        @default("user")
  createdAt       DateTime      @default(now())

  rectification   Rectification @relation(fields: [rectificationId], references: [id])

  @@index([rectificationId])
}
